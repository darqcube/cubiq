# Cubiq's seven MCP servers, for the platform's MCP server configuration.
# Generated by scripts/ai-platform-connect.py. Each server checks the caller's
# own token (forwarded by the platform in the header below), so a call is
# attributable to a person; its client decides its scope (read or execute).
mcp_servers:
# --- per server ---
  - id: "darqcube-{name}"
    name: "Cubiq {name}"
    description: "{description}"
    transport: "http"
    endpoint: "http://{stack_host}:{port}/mcp"
    enabled: true
    credential_sources:
      - kind: "caller_token"
        name: "{token_header}"
        target: "header"
        fallback_client_credentials: true
