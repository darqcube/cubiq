# Alertmanager.
#
# THIS FILE IS A TEMPLATE. config-init (every `make up`) and `make render` write the running config from it to
# observability/telegraf/generated/alertmanager.yml; `make render` also reloads Alertmanager. Edit this file, not the
# generated copy.
#
# EVERY ALERT GOES TO TWO RECEIVERS, and nothing here decides which alert matters to whom:
#   notify    this stack's own receiver, ALERT_WEBHOOK_URL (site.yml alerts.webhook_url)
#   platform  a connected platform's, PLATFORM_ALERT_WEBHOOK_URL (agenticops.yml alerts.webhook)
# Which alerts start an investigation, or reach which people, is the platform's policy. Each delivery names its
# receiver in the body ("receiver"). The URLs are read from files config-init writes (url_file), so neither this
# template nor the generated config holds them; an empty one points at a local no-op, so the stack starts with no
# external dependency.
route:
  receiver: notify
  group_by: [alertname, device]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Every alert to the platform; continue, so each also reaches the stack's own receiver below.
    - receiver: platform
      continue: true
    - matchers: [severity="critical"]
      receiver: notify
      repeat_interval: 1h
    - receiver: notify

receivers:
  - name: notify
    webhook_configs:
      - url_file: /etc/alertmanager/webhook-url
        send_resolved: true
  - name: platform
    webhook_configs:
      - url_file: /etc/alertmanager/platform-webhook-url
        send_resolved: true

inhibit_rules:
  # A device that is unreachable will also have every interface "down". Report
  # the cause, not the hundred symptoms.
  - source_matchers: [alertname="DeviceUnreachable"]
    target_matchers: [alertname="InterfaceDown"]
    equal: [device]
