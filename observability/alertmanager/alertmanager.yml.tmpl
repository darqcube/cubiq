# Alertmanager.
#
# THIS FILE IS A TEMPLATE. config-init (every `make up`) and `make render` write the running config from it to
# observability/telegraf/generated/alertmanager.yml; `make render` also reloads Alertmanager. Edit this file, not the
# generated copy.
#
# EVERY ALERT GOES TO TWO RECEIVERS, and nothing here decides which alert matters to whom (alerts from syslog, the
# fast path, go to the platforms without waiting: their own route below):
#   notify    this stack's own receiver, ALERT_WEBHOOK_URL (site.yml alerts.webhook_url)
#   platform  every connected platform's, one webhook each (agenticops.yml platforms.<name>.alert_webhook), with
#             that platform's token as a Bearer header (install.py --platform-token NAME)
# Which alerts start an investigation, or reach which people, is each platform's policy. Each delivery names its
# receiver in the body ("receiver"). URLs and tokens are read from files config-init writes (url_file,
# credentials_file), so neither this template nor the generated config holds them. A receiver with nothing set up
# (ALERT_WEBHOOK_URL empty, no platform connected) has no integration at all: Alertmanager sends nothing for it.
route:
  receiver: notify
  group_by: [alertname, device]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Every alert to the platform; continue, so each also reaches the stack's own receiver below.
    - receiver: platform
      continue: true
      routes:
        # Alerts from the device's own syslog line (Logstash, source=syslog): seconds matter, so no group wait, one
        # group per link or neighbour (a second link down is its own notification, not 5 minutes behind the first),
        # and its "up" line's resolve sent within 10 s. Polled alerts keep the grouping above.
        - matchers: [source="syslog"]
          group_by: [alertname, device, ifName, peer, router_id]
          group_wait: 0s
          group_interval: 10s
    - matchers: [severity="critical"]
      receiver: notify
      repeat_interval: 1h
    - receiver: notify

receivers:
  - name: notify
    # NOTIFY_WEBHOOK: config-init and make render insert generated/alertmanager-notify.yml below this line.
  - name: platform
    # PLATFORM_WEBHOOKS: config-init and make render insert generated/alertmanager-platforms.yml below this line.

inhibit_rules:
  # A device that is unreachable will also have every interface "down". Report
  # the cause, not the hundred symptoms.
  - source_matchers: [alertname="DeviceUnreachable"]
    target_matchers: [alertname="InterfaceDown"]
    equal: [device]
